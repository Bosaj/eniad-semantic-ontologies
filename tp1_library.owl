<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
   xmlns:ex="http://www.example.org/library#"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="http://www.example.org/library#hasTitle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.example.org/library#Book"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/library#hasAuthor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.example.org/library#Book"/>
    <rdfs:range rdf:resource="http://www.example.org/library#Author"/>
    <owl:inverseOf rdf:resource="http://www.example.org/library#isAuthorOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/library#TheLittlePrince">
    <rdf:type rdf:resource="http://www.example.org/library#Book"/>
    <ex:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Le Petit Prince</ex:hasTitle>
    <ex:publicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1943</ex:publicationYear>
    <ex:hasAuthor rdf:resource="http://www.example.org/library#SaintExupery"/>
    <ex:borrowedBy rdf:resource="http://www.example.org/library#PierreDurand"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/library#Author">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/library#SaintExupery">
    <rdf:type rdf:resource="http://www.example.org/library#Author"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/library#Book">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.example.org/library#Document"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/library#borrowedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.example.org/library#Book"/>
    <rdfs:range rdf:resource="http://www.example.org/library#User"/>
    <owl:inverseOf rdf:resource="http://www.example.org/library#hasBorrowed"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/library#Borrowing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/library#hasBorrowed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.example.org/library#User"/>
    <rdfs:range rdf:resource="http://www.example.org/library#Book"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/library#isAuthorOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.example.org/library#Author"/>
    <rdfs:range rdf:resource="http://www.example.org/library#Book"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/library#PierreDurand">
    <rdf:type rdf:resource="http://www.example.org/library#User"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/library#Document">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/library#publicationYear">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.example.org/library#Book"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/library#User">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
</rdf:RDF>
