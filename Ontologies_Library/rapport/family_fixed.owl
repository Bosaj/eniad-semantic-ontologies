<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.example.org/family#"
     xml:base="http://www.example.org/family"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
  <owl:Ontology rdf:about="http://www.example.org/family"/>

  <!-- Classes -->
  <owl:Class rdf:about="#Person"/>
  <owl:Class rdf:about="#Parent">
    <rdfs:subClassOf rdf:resource="#Person"/>
  </owl:Class>
  <owl:Class rdf:about="#Child">
    <rdfs:subClassOf rdf:resource="#Person"/>
  </owl:Class>

  <!-- Propriétés d'objet -->
  <owl:ObjectProperty rdf:about="#hasChild">
    <rdfs:domain rdf:resource="#Parent"/>
    <rdfs:range rdf:resource="#Child"/>
    <owl:inverseOf rdf:resource="#hasParent"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#hasParent">
    <rdfs:domain rdf:resource="#Child"/>
    <rdfs:range rdf:resource="#Parent"/>
  </owl:ObjectProperty>

  <!-- Propriété de données -->
  <owl:DatatypeProperty rdf:about="#hasAge">
    <rdfs:domain rdf:resource="#Person"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>

  <!-- Individus -->
  <owl:NamedIndividual rdf:about="#Jean">
    <rdf:type rdf:resource="#Parent"/>
    <hasAge rdf:datatype="xsd:integer">40</hasAge>
    <hasChild rdf:resource="#Paul"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Marie">
    <rdf:type rdf:resource="#Parent"/>
    <hasAge rdf:datatype="xsd:integer">38</hasAge>
    <hasChild rdf:resource="#Paul"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Paul">
    <rdf:type rdf:resource="#Child"/>
    <hasAge rdf:datatype="xsd:integer">10</hasAge>
  </owl:NamedIndividual>
</rdf:RDF>
